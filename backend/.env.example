# ── Database (MySQL) ──────────────────────────────
# PERHATIAN: password di URL ini mengandung karakter spesial (@ dan %) yang
# TIDAK di-encode. Dalam format URI, karakter tsb bisa bikin parser salah
# menentukan batas antara password dan host. Kalau koneksi database gagal
# padahal password sudah benar, ini kemungkinan besar penyebabnya — lihat
# catatan "url-encode password" di bagian bawah file ini.
DATABASE_URL="mysql://root:iimmaann1122334455!!@@##$$%%@localhost:3306/db_lppm"

# ── App ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# TRUST_PROXY=true hanya kalau app ini jalan di belakang reverse proxy
# (Nginx, load balancer, dll) di production. Kalau true, Express akan
# percaya header X-Forwarded-For untuk menentukan req.ip (IP client asli),
# bukan IP proxy. JANGAN set true kalau app diakses langsung tanpa proxy
# (misal saat dev di localhost) — bisa disalahgunakan untuk spoof IP.
TRUST_PROXY=false

# ── JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=95ce4c2ee4f098be6c47a3b5db770a2b31beb623ef85b6b7ce0b56f774d0df9a
JWT_REFRESH_SECRET=f21e334ed313fad563b3bcb4f2ccf487809e761ac0337ca71d6aeaae6f6f417b
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate Limit ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Email (opsional — untuk fitur reset password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Field di bawah ini dibaca oleh src/utils/email.ts tapi belum ada
# sebelumnya di file kamu — ditambahkan supaya link reset password
# terbentuk dengan benar (kalau kosong, hasilnya "undefined/reset-password?...").
APP_NAME="LPPM App"
FRONTEND_URL=http://localhost:5173

# ── Catatan: url-encode password MySQL ─────────────
# Password di atas berisi karakter "!@#$%" yang punya arti khusus dalam
# format URI. Kalau `npm run db:migrate` atau `db:seed` gagal connect
# padahal MySQL sudah jalan dan password sudah benar, coba encode
# karakter spesialnya jadi bentuk %XX, contoh:
#   @ → %40   #  → %23   $ → %24   % → %25
# Atau paling gampang: test dulu pakai password sederhana tanpa simbol
# untuk memastikan bukan itu penyebabnya, baru pertimbangkan ganti
# password MySQL kalau mau tetap pakai simbol.
