# ── Database (MySQL / MariaDB) ───────────────────
# Format sama dengan DATABASE_URL Prisma di backend Node.
# Password dengan karakter spesial (@ # $ % !) boleh ditulis apa adanya
# maupun di-URL-encode (%40 %23 %24 %25 %21) — keduanya didukung.
DATABASE_URL="mysql://root:password@localhost:3306/db_lppm"

# ── App ──────────────────────────────────────────
PORT=3000
# NODE_ENV dipertahankan namanya supaya .env lama bisa dipakai ulang.
# "production" → pesan error disembunyikan ("Internal server error").
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# true hanya jika berjalan di belakang reverse proxy (Nginx, dll).
TRUST_PROXY=false

# ── JWT (pakai secret yang SAMA dengan backend Node agar token lama tetap valid)
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate Limit ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Email (fitur lupa password) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
APP_NAME="LPPM App"
FRONTEND_URL=http://localhost:5173

# Backup database otomatis (sebulan sekali) + manual oleh admin (GET/POST /api/v1/backup)
BACKUP_OTOMATIS=true          # false = matikan backup otomatis (manual tetap bisa)
BACKUP_DIR=backups            # folder file .sql.gz di server
BACKUP_HARI=1                 # tanggal 1-28 setiap bulan
BACKUP_JAM=2                  # jam 0-23
BACKUP_ZONA=Asia/Jakarta
